# Kalimni API - environment variables
PORT=4000
# PostgreSQL connection. `docker compose up -d` (project root) starts a dev
# instance matching this URL; then `npm run db:setup` creates schema + demo data.
# REQUIRED — the API refuses to boot without it.
DATABASE_URL=postgres://kalimni:kalimni@localhost:5433/kalimni
# REQUIRED, minimum 32 chars — the API refuses to boot otherwise. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
TOKEN_TTL=30d
# DEVELOPMENT ONLY. When "true", POST /api/auth/google accepts { email, name }
# without verifying a Google ID token. Off by default; the API refuses to boot
# if this is set in production (NODE_ENV=production).
MOCK_GOOGLE_AUTH=false
# OAuth client id for real Google sign-in (audience of the ID tokens the app
# sends). Empty -> /api/auth/google answers 501; email/password still works.
GOOGLE_CLIENT_ID=

# Voice calls (Agora). Free account: https://console.agora.io
# Leave both empty to keep call signaling (ringing/accept/reject) working while
# the client shows "calling is not configured yet" instead of joining audio.
# AGORA_APP_ID from an Agora project. Works alone if that project's
# authentication mode is "App ID" (testing mode, no certificate).
AGORA_APP_ID=
# Only needed if the Agora project has certificate auth enabled ("Secured
# mode"). Generates a short-lived RTC token per user per call.
AGORA_APP_CERTIFICATE=

# AI risk classifier — layer 2 of the safety net (see src/services/riskService.js).
# Any OpenAI-compatible endpoint. Free Gemini key: https://aistudio.google.com/apikey
# Leave AI_API_KEY empty to disable the LLM layer (keyword scan still runs).
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
AI_API_KEY=

# Voice-note transcription — safety screening for audio messages (they carry no
# text, so both risk layers would otherwise be blind to them). Any
# OpenAI-compatible /audio/transcriptions endpoint (OpenAI whisper-1, Groq
# whisper-large-v3-turbo, self-hosted Whisper). When AI_BASE_URL points at Groq
# or OpenAI these default to that same endpoint + key, so screening is on
# automatically. Unset on other providers -> voice notes are NOT screened and
# specialists see them marked "unmonitored".
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_API_KEY=
